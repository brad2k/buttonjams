---
// src/components/Event.astro
import { Image } from "astro:assets";
import calendarSvg from "../assets/calendar.svg";

interface Props {
  category: string;
  title: string;
  dateTime: Date;
  children?: string;
  link: string;
  location: string;
}

const {
  category = "Performance",
  title,
  dateTime,
  children,
  link,
  location,
  ...rest
} = Astro.props;
---

<li class="event" {...rest}>
  <strong class="event-category">{category}</strong>
  <div class="event-details">
    <h3 class="event-heading">{title}</h3>
    <div class="event-info">
      <time class="event-date">
        <Image src={calendarSvg} alt="Calendar icon" class="calendar-icon" />
        <span
          >{
            dateTime.toLocaleString("en-US", {
              // weekday: "long",
              // year: "numeric",
              // month: "long",
              // day: "numeric",
              dateStyle: "short",
              timeStyle: "short",
            })
          }</span
        ></time
      >
      <p>{location}</p>
    </div>

    {children ? <p>{children}</p> : null}
  </div>

  <a href={link} target="_blank" rel="noopener" class="button">More info</a>
</li>

<style>
  .event {
    padding: var(--space-m);
    background-color: var(--text-decoration-color);
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: max-content auto max-content;
    gap: var(--space-s);

    button {
      display: inline-block;
    }
  }

  .event-heading {
    font-size: var(--size-step-1);
  }

  .event-category {
    text-transform: uppercase;
    /* font-size: var(--size-step-00); */
  }

  .event-details {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: max-content;
    gap: var(--space-s);
    line-height: 1.5;
  }

  .event-date {
    display: inline-flex;
    align-items: center;
  }

  .calendar-icon {
    width: 1.2em;
    height: 1.2em;
    margin-inline-end: var(--space-xs);
  }
</style>
