---
import Card from "./Card.astro";
import { Calendar } from "@lucide/astro";

interface Props {
  category: string;
  title: string;
  dateTime: string;
  children?: string;
  link: string | URL;
  location: string;
}

const {
  category = "Performance",
  title,
  dateTime,
  children,
  link,
  location,
  ...rest
} = Astro.props;

const url = new URL(link);
url.searchParams.append("utm_source", "jamesbuttonoboe.com");
const ammendedLink = url.toString();
---

<Card as="li" class="event" {...rest}>
  <strong class="event-category">{category}</strong>
  <div class="event-details">
    <h3 class="event-heading">{title}</h3>
    <div class="event-info">
      <time class="event-date">
        <Calendar class="calendar-icon" />
        <span>{dateTime}</span></time
      >
      <p>{location}</p>
    </div>

    <p><slot /></p>
  </div>

  <a href={ammendedLink} target="_blank" rel="noopener" class="button">
    More info
  </a>
</Card>

<style>
  :root {
    &[data-theme="light"] {
      --event-category-color: var(--text-as-accent);
    }

    &[data-theme="dark"] {
      --event-category-color: var(--color-neutral-100);
    }
  }

  .event {
    grid-template-columns: 1fr;
    grid-template-rows: max-content auto max-content;
  }

  .event-heading {
    font-size: var(--font-size-h6);
  }

  .event-category {
    text-transform: uppercase;
    color: var(--event-category-color);
  }

  .event-details {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: max-content;
    gap: var(--space-s);
    line-height: var(--leading-standard);
  }

  .event-date {
    display: inline-flex;
    align-items: center;
  }

  .calendar-icon {
    width: 1.2em;
    height: 1.2em;
    margin-inline-end: var(--space-xs);
  }
</style>
