---
interface Props {
  className?: string;
  as?: HTMLElement;
}

const { className, as, ...rest } = Astro.props;

const Tag = as || "div";
---

<Tag class:list={["card", className]} {...rest}>
  <slot />
</Tag>

<style>
  .card {
    background-color: var(--color-shade-1);
    padding: var(--space-m);
    border: 1px solid var(--color-shade-2);
    border-radius: var(--radius-m);
    display: grid;
    gap: var(--space-s);
  }
</style>
