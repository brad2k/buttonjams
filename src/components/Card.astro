---
interface Props {
  className?: string;
  as?: HTMLElement;
}

const { className, as, ...rest } = Astro.props;

const Tag = as || "div";
---

<Tag class:list={["card", className]} {...rest}>
  <slot />
</Tag>

<style>
  .card {
    background-color: light-dark(
      var(--color-neutral-200),
      var(--color-dark-700)
    );
    padding: var(--space-m);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-m);
    display: grid;
    gap: var(--space-s);
  }
</style>
