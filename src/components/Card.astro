---
interface Props {
  className?: string;
  as?: HTMLElement;
}

const { className, as, ...rest } = Astro.props;

const Tag = as || "div";
---

<Tag class:list={["card", className]} {...rest}>
  <slot />
</Tag>

<style>
  .card {
    background-color: light-dark(var(--color-shade-1), var(--color-dark));
    padding: var(--space-m);
    border: 1px solid light-dark(var(--border-light), var(--border-dark));
    border-radius: var(--radius-m);
    display: grid;
    gap: var(--space-s);
  }
</style>
