---
import InstagramLogo from "../assets/svg/instagram.svg";

const links = [
  { href: "/about/", label: "About" },
  { href: "/audition-coaching/", label: "Audition coaching" },
  { href: "/listen/", label: "Listen" },
  { href: "/events/", label: "Events" },
  { href: "/contact/", label: "Contact" },
];
---

<ul class="header-menu">
  {
    links.map((link) => (
      <li>
        <a href={link.href}>{link.label}</a>
      </li>
    ))
  }
  <li>
    <a
      href="https://www.instagram.com/buttonjamss/"
      target="_blank"
      rel="noopener noreferrer"
      ><InstagramLogo height={22} width={22} />
    </a>
  </li>
</ul>

<style>
  .header-menu {
    display: flex;
    font-size: var(--size-step-0);

    a {
      color: var(--nav-text-color);
      text-decoration-color: transparent;
      text-underline-offset: 0.2em;
      transition:
        text-decoration-color var(--transition-base),
        text-underline-offset var(--transition-base);
      position: relative;

      &[aria-current="page"] {
        text-decoration-color: currentColor;
        text-underline-offset: 0.3em;
      }

      @media (hover: hover) {
        &:hover {
          text-decoration-color: currentColor;
          text-underline-offset: 0.3em;
        }
      }
    }

    svg {
      display: block;
    }

    @media (max-width: 55rem) {
      flex-direction: column;
      padding-inline: var(--space-m);
      margin-block-start: calc(
        var(--headerPadding) + var(--space-m) + var(--space-m)
      );

      a {
        display: block;
        padding: var(--space-s);
        color: light-dark(var(--color-dark-700), var(--color-neutral-100));

        @media (hover: hover) {
          &:hover,
          &:focus {
            background-color: light-dark(
              var(--color-neutral-200),
              var(--color-dark-500)
            );
          }
        }
      }
    }

    @media (min-width: 55rem) {
      align-items: center;
      gap: var(--space-l);
    }
  }
</style>
