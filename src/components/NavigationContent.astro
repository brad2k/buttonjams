---
import { Image } from "astro:assets";
import instagramLogo from "../assets/instagram.svg";
---

<ul class="header-menu">
  <li><a href="/about">About</a></li>
  <li><a href="/audition-coaching">Audition coaching</a></li>
  <li><a href="/listen">Listen</a></li>
  <li><a href="/events">Events</a></li>
  <li><a href="/contact">Contact</a></li>
  <li>
    <a
      href="https://www.instagram.com/buttonjamss/"
      target="_blank"
      rel="noopener noreferrer"
      ><Image
        src={instagramLogo}
        alt="Instagram logo"
        role="img"
        height={22}
        width={22}
      /></a
    >
  </li>
</ul>

<style>
  .header-menu {
    display: flex;
    list-style: none;
    font-size: var(--size-step-0);
    color: #000;

    a {
      text-decoration: none;
      text-decoration-color: transparent;
      text-underline-offset: 0.2em;
      transition:
        text-decoration-color 0.3s,
        text-underline-offset 0.3s ease-in-out; /* Transition for the offset */

      @media (hover: hover) {
        &:hover {
          text-decoration: underline;
          text-decoration-color: oklch(from currentColor l c h / 0.5);
          text-underline-offset: 0.3em;
        }
      }
    }

    @media (max-width: 55rem) {
      flex-direction: column;
      padding-inline: var(--space-m);
      margin-block-start: calc(
        var(--headerPadding) + var(--space-m) + var(--space-m)
      );

      a {
        display: block;
        padding: var(--space-s);

        @media (hover: hover) {
          &:hover,
          &:focus {
            background-color: var(--color-light-shade);
          }
        }
      }
    }

    @media (min-width: 55rem) {
      gap: var(--space-l);
    }
  }
</style>
