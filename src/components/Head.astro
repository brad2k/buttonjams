---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import socialImage from "../assets/james-button-social.jpg";
import PostHog from "../components/posthog.astro";

interface Props {
  pageTitle?: string;
}
const { pageTitle } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <Font cssVariable="--font-Playfair" preload />
  <Font cssVariable="--font-Montserrat" preload />
  <PostHog />

  <title>{`James Button — ${pageTitle || "San Francisco oboist"}`}</title>
  <link rel="canonical" href="https://jamesbuttonoboe.com" />
  <meta
    name="description"
    content="James Button is a San Francisco-based oboist and Associate Principal Oboe of the San Francisco Symphony. He offers woodwind audition coaching and adult oboe lessons in San Francisco or online."
  />
  <meta name="generator" content={Astro.generator} />
  <meta property="og:title" content="James Button — oboist" />
  <meta
    property="og:description"
    content="San Francisco-based oboist and Associate Principal Oboe of the San Francisco Symphony offering audition coaching and adult oboe lessons."
  />
  <meta property="og:image" content={socialImage.src} />
  <meta
    property="og:image:alt"
    content="James Button holding his Marigaux 920A oboe"
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://jamesbuttonoboe.com/" />
  <meta property="og:locale" content="en_US" />

  <ClientRouter />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "James Button",
      "jobTitle": "Oboist",
      "url": "https://jamesbuttonoboe.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "San Francisco",
        "addressRegion": "CA"
      },
      "sameAs": [
        "https://www.instagram.com/buttonjamss/",
        "https://www.sfsymphony.org/Data/Event-Data/Artists/B/James-Button"
      ],
      "offers": {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Woodwind Audition Coaching",
          "description": "Professional woodwind audition coaching."
        }
      }
    }
  </script>
</head>
