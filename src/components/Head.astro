---
import { Font } from "astro:assets";
import PostHog from "../components/posthog.astro";
import socialImage from "../assets/james-button-social.jpg";
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <Font cssVariable="--font-Playfair" preload />
  <Font cssVariable="--font-Montserrat" preload />
  <PostHog />

  <title>James Button — San Francisco oboist</title>
  <meta
    name="description"
    content="James Button is a San Francisco-based oboist and Associate Principal Oboe of the San Francisco Symphony. He offers audition coaching and adult oboe lessons in San Francisco or online."
  />
  <meta name="generator" content={Astro.generator} />
  <meta property="og:title" content="James Button — oboist" />
  <meta property="og:image" content={socialImage.src} />
  <meta
    property="og:image:alt"
    content="James Button holding his Marigaux 920A oboe"
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://jamesbuttonoboe.com/" />
</head>
