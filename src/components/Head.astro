---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import socialImage from "../assets/james-button-social.jpg";
import PostHog from "../components/posthog.astro";

interface Props {
  heroImage?: string;
  heroImageSrcSet?: string;
  heroImageSizes?: string;
  pageTitle?: string;
}
const { pageTitle } = Astro.props;

const siteUrl = "https://jamesbuttonoboe.com";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#james-button`,
  name: "James Button",
  jobTitle: "Associate Principal Oboe",
  description:
    "Oboist James Button has been Associate Principal Oboe of the San Francisco Symphony since 2017. He offers woodwind audition coaching and adult oboe lessons in San Francisco or online.",
  url: siteUrl,
  image: new URL(socialImage.src, Astro.site ?? siteUrl).href,
  homeLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: "San Francisco",
      addressRegion: "CA",
      addressCountry: "US",
    },
  },
  worksFor: {
    "@type": "MusicGroup",
    name: "San Francisco Symphony",
    url: "https://www.sfsymphony.org",
  },
  affiliation: {
    "@type": "Organization",
    name: "Marigaux",
    url: "https://www.marigaux.com/en/artists/",
  },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Temple University" },
    { "@type": "CollegeOrUniversity", name: "The Juilliard School" },
    { "@type": "MusicGroup", name: "Nashville Symphony" },
  ],
  award:
    "Grammy Award, 2018 (Jennifer Higdon's Oboe Concerto, Nashville Symphony)",
  knowsAbout: [
    "Oboe",
    "Woodwind audition coaching",
    "Orchestral auditions",
    "Chamber music",
    "Oboe reed making",
  ],
  sameAs: [
    "https://www.instagram.com/buttonjamss/",
    "https://www.sfsymphony.org/Data/Event-Data/Artists/B/James-Button",
  ],
  makesOffer: [
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Woodwind Audition Coaching",
        description:
          "Audition coaching for all woodwind instruments, drawing on 25+ years of professional auditions and service on San Francisco Symphony audition committees. Suited to professional orchestra, music school and summer festival auditions.",
        url: `${siteUrl}/audition-coaching/`,
        areaServed: "San Francisco, CA and online",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Adult Oboe Lessons",
        description:
          "Private oboe lessons for adults, in San Francisco or online.",
        url: `${siteUrl}/contact/`,
        areaServed: "San Francisco, CA and online",
      },
    },
  ],
};

const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site);
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <Font cssVariable="--font-Playfair" />
  <Font cssVariable="--font-Montserrat" />
  <PostHog />

  <title>{`James Button | ${pageTitle || "San Francisco Oboist"}`}</title>
  <link rel="canonical" href={canonical} />
  <meta
    name="description"
    content="James Button is a San Francisco-based oboist and Associate Principal Oboe of the San Francisco Symphony. He offers woodwind audition coaching and adult oboe lessons in San Francisco or online."
  />
  <meta name="generator" content={Astro.generator} />
  <meta
    property="og:title"
    content={`James Button | ${pageTitle ? pageTitle + " | " : ""}San Francisco Oboist`}
  />
  <meta
    property="og:description"
    content="San Francisco-based oboist and Associate Principal Oboe of the San Francisco Symphony offering audition coaching and adult oboe lessons."
  />
  <meta property="og:image" content={socialImage.src} />
  <meta
    property="og:image:alt"
    content="James Button holding his Marigaux 920A oboe in the lobby of Davies Symphony Hall"
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://jamesbuttonoboe.com/" />
  <meta property="og:locale" content="en_US" />

  <link rel="sitemap" href="/sitemap-index.xml" />

  <ClientRouter />

  <script>
    const theme =
      localStorage.getItem("theme") ||
      (window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light");

    document.documentElement.dataset.theme = theme;
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
