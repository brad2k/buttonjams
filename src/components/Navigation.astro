---
import NavigationContent from "../components/NavigationContent.astro";
import MenuIcon from "../assets/svg/menu.svg";
import CloseIcon from "../assets/svg/close.svg";
---

<header class="header" transition:persist>
  <div class="wrapper header-wrapper">
    <a href="/" class="header-logo">
      <span class="first-name">James</span>
      <span class="last-name">Button</span>
      <span class="oboe-title">Oboist</span>
    </a>

    <button
      class="menu-button"
      aria-label="Toggle menu"
      aria-controls="primary-navigation"
      aria-expanded="false"
    >
      <span class="visually-hidden">Menu</span>
      <MenuIcon aria-hidden="true" />
      <CloseIcon aria-hidden="true" />
    </button>

    <nav id="primary-navigation"><NavigationContent /></nav>
  </div>
</header>

<script>
  const navToggle = document.querySelector(
    '[aria-controls="primary-navigation"]',
  ) as HTMLButtonElement;

  function toggleMenu() {
    const isOpen = navToggle.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  }

  function closeMenu() {
    navToggle.setAttribute("aria-expanded", "false");
  }

  function openMenu() {
    navToggle.setAttribute("aria-expanded", "true");
  }

  function highlightActiveLink() {
    const navLinks = document.querySelectorAll(
      ".header-menu a",
    ) as NodeListOf<HTMLAnchorElement>;

    navLinks.forEach((link) => {
      const linkPath = new URL(link.href).pathname;
      if (linkPath === window.location.pathname) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  document.addEventListener("astro:page-load", () => {
    // Add menu toggle event listener
    navToggle.addEventListener("click", toggleMenu);

    // Highlight the active link on initial load
    highlightActiveLink();
  });

  document.addEventListener("astro:before-swap", (event) => {
    // Remove menu event listener to prevent multiple bindings
    document.removeEventListener("click", toggleMenu);

    // Close the menu on navigation
    closeMenu();
  });
</script>

<style>
  :root {
    --headerPadding: var(--space-m);
  }

  .header-wrapper {
    display: flex;
    justify-content: space-between;
    padding: var(--headerPadding);
  }

  .header-logo {
    font-family: var(--font-Playfair);
    font-size: var(--size-step-4);
    text-decoration: none;
    color: var(--nav-text-color);
    line-height: var(--leading-flat);
    word-break: normal;
  }

  .oboe-title {
    display: block;
    font-size: var(--size-step-3);
    text-align: right;
    margin-block-start: 0.25rem;
  }

  #primary-navigation {
    display: none;

    [aria-expanded="true"] + & {
      display: block;
    }

    @media (min-width: calc(55rem + 1px)) {
      display: block;
    }

    @media (max-width: 55rem) {
      position: absolute;
      z-index: 1000;
      inset: 0;
      height: 100dvh;
      background-color: light-dark(
        var(--color-neutral-100),
        var(--color-dark-700)
      );
    }
  }

  /* open the navigation */

  .menu-button {
    height: 32px;
    width: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    outline-offset: 2px;
    z-index: 1001;

    @media (min-width: 55rem) {
      display: none;
    }
  }

  .icon {
    stroke: currentColor;
    display: block;
  }

  .icon--menu-open {
    color: var(--nav-text-color);

    [aria-expanded="true"] & {
      display: none;
    }
  }

  .icon--menu-close {
    display: none;

    [aria-expanded="true"] & {
      display: block;
    }
  }

  /* Prevent scrolling when menu is open */
  body:has([aria-expanded="true"]) {
    overflow: hidden;
    position: fixed;
    height: 100%;
    width: 100%;
  }

  /* if the body has a hero element then position the menu absolutely (just the homepage) */
  body:has(.hero-container) {
    .header {
      position: absolute;
      width: 100%;
      background: linear-gradient(
        to bottom,
        oklch(from black l c h / 0.1),
        transparent
      );
      z-index: 1;
    }

    .header-logo {
      font-size: var(--size-step-6);
    }

    .last-name {
      display: block;
      margin-inline-start: 0.45ch;
    }

    /* Logo animation (homepage only) */
    .first-name,
    .last-name,
    .oboe-title {
      animation: fadeIn var(--transition-fade);
      animation-fill-mode: both;

      @media (prefers-reduced-motion: reduce) {
        animation: none;
      }
    }

    .last-name {
      animation-delay: 0.5s;
    }

    .oboe-title {
      animation-delay: 1s;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
