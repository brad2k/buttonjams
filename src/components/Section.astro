---
interface Props {
  className?: string;
}

const { className, ...rest } = Astro.props;
---

<section class:list={["content-section", className]} {...rest}>
  <slot />
</section>

<style>
  .content-section {
    padding-block: var(--space-xl);

    @media (min-width: 600px) {
      padding-block: var(--space-3xl);
    }
  }
</style>
