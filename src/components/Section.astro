---
interface Props {
  className?: string;
  as?: HTMLElement;
}

const { className, ...rest } = Astro.props;

const Tag = Astro.props.as || "section";
---

<Tag class:list={["content-section", className]} {...rest}>
  <slot />
</Tag>

<style>
  .content-section {
    padding-block: var(--space-xl);
  }
</style>
