---
import { Camera } from "@lucide/astro";
import type { SanityDocument } from "@sanity/client";
import { PortableText } from "astro-portabletext";
import { Image } from "astro:assets";
import playingPhoto from "../assets/james-button-playing.avif";
import Heading from "../components/Heading.astro";
import Section from "../components/Section.astro";
import Layout from "../layouts/Layout.astro";
import ProseLayout from "../layouts/ProseLayout.astro";
import { loadQuery } from "../sanity/lib/load-query";

const { data } = await loadQuery<SanityDocument>({
  query: `*[_type == "page" && slug.current == "audition-coaching"][0]{
    headline,
    imageAlt,
    imageCaption,
    imageCaptionIsPhotoCredit,
    content,
    seo
  }`,
});
---

<Layout pageTitle="Woodwind audition coaching">
  <Section className="wrapper flow" as="div">
    <Heading level={1} emphasis>{data.headline}</Heading>

    <ProseLayout>
      <figure slot="figure">
        <Image
          src={playingPhoto}
          width={playingPhoto.width / 2}
          alt={data.imageAlt}
          class="prose--image"
          format="avif"
          densities={[1, 1.5, 2]}
          priority
        />
        <figcaption>
          {
            data.imageCaptionIsPhotoCredit && (
              <>
                <Camera />
                <span class="visually-hidden">Photo credit:</span>
              </>
            )
          }
          {data.imageCaption}
        </figcaption>
      </figure>

      <PortableText value={data.content} />
    </ProseLayout>
  </Section>
</Layout>
