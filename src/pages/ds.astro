---
import Heading from "../components/Heading.astro";
import Section from "../components/Section.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Section className="wrapper" as="div">
    <Heading level={1} emphasis>Design System</Heading>

    <Section className="flow">
      <Heading level={2}>Type</Heading>

      <div class="type">
        <div class="flow">
          <Heading level={3}>Steps</Heading>

          <div>
            <p style="font-size: var(--size-step-000);">Step 000</p>
            <p style="font-size: var(--size-step-00);">Step 00</p>
            <p style="font-size: var(--size-step-0);">Step 0</p>
            <p style="font-size: var(--size-step-1);">Step 1</p>
            <p style="font-size: var(--size-step-2);">Step 2</p>
            <p style="font-size: var(--size-step-3);">Step 3</p>
            <p style="font-size: var(--size-step-4);">Step 4</p>
            <p style="font-size: var(--size-step-5);">Step 5</p>
            <p style="font-size: var(--size-step-6);">Step 6</p>
          </div>
        </div>

        <div class="flow">
          <Heading level={3}>Fonts</Heading>

          <div class="prose flow">
            <Heading level={4}>Playfair (logo)</Heading>

            <p style="font-family: var(--font-Playfair);">
              James Button was appointed Associate Principal Oboe of the San
              Francisco Symphony in September 2017.
            </p>

            <Heading level={4}>Montserrat (body)</Heading>
            <p style="font-family: var(--font-Montserrat);">
              James Button was appointed Associate Principal Oboe of the San
              Francisco Symphony in September 2017.
            </p>
          </div>
        </div>
      </div>
    </Section>

    <Section className="flow">
      <Heading level={2}>Colors</Heading>
      <div class="swatches">
        <div class="swatch" style="--swatchBg: var(--color-primary);"></div>
        <div class="swatch" style="--swatchBg: var(--color-dark-700);"></div>
        <div class="swatch" style="--swatchBg: var(--color-dark-500);"></div>
        <div class="swatch" style="--swatchBg: var(--color-neutral-400);"></div>
        <div class="swatch" style="--swatchBg: var(--color-neutral-300);"></div>
        <div class="swatch" style="--swatchBg: var(--color-neutral-200);"></div>
        <div class="swatch" style="--swatchBg: var(--color-neutral-100);"></div>
      </div>
    </Section>
  </Section>
</Layout>

<style>
  .type {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    grid-template-rows: 100px;
  }

  .swatch {
    background-color: var(--swatchBg);
  }
</style>
