---
import { Image } from "astro:assets";
import Heading from "../components/Heading.astro";
import ProseLayout from "../layouts/ProseLayout.astro";
import Section from "../components/Section.astro";
import Layout from "../layouts/Layout.astro";
import { PortableText } from "astro-portabletext";

import muralPhoto from "../assets/james-button-mural.jpg";
import { Camera } from "@lucide/astro";

import type { SanityDocument } from "@sanity/client";
import { loadQuery } from "../sanity/lib/load-query";

// Query for the specific page by slug

const { data } = await loadQuery<SanityDocument>({
  query: `*[_type == "page" && slug.current == "about"][0]{
    headline,
    image,
    imageAlt,
    imageCaption,
    imageCaptionIsPhotoCredit,
    content,
    seo
  }`,
});
---

<Layout pageTitle="About">
  <Section className="wrapper flow" as="div">
    <Heading level={1} emphasis>{data.headline}</Heading>

    <ProseLayout>
      <figure slot="figure">
        <Image
          src={muralPhoto}
          width={480}
          alt={data.imageAlt}
          class="prose--image"
          format="avif"
          densities={[1, 1.5, 2]}
          priority
        />
        <figcaption>
          {data.imageCaptionIsPhotoCredit && (
            <><Camera /><span class="visually-hidden">Photo credit:</span></>
          )}
          {data.imageCaption}
        </figcaption>
      </figure>

      <PortableText value={data.content} />
    </ProseLayout>
  </Section>
</Layout>
