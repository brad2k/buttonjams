---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import Card from "../components/Card.astro";

import PlayIcon from "../assets/svg/play.svg";
import RewindIcon from "../assets/svg/rewind.svg";
import PauseIcon from "../assets/svg/pause.svg";
import PlayingIcon from "../assets/svg/playing.svg";
import MusicIcon from "../assets/svg/music.svg";

interface SongProps {
  id: string;
  src?: string;
  filename: string;
  name: string;
  description: string;
}

const songs: SongProps[] = [
  {
    id: "albinoni",
    src: (await import(`../assets/audio/albinoni-concerto.mp3`)).default,
    filename: "albinoni-concerto.mp3",
    name: "Albinoni: Concerto for Two Oboes in G Major",
    description: "2nd movement (performing all parts)",
  },
  {
    id: "sheherazade",
    src: (await import(`../assets/audio/sheherazade.mp3`)).default,
    filename: "sheherazade.mp3",
    name: "Ravel: Scheherazade",
    description: "2nd movement solo",
  },
  {
    id: "tombeau",
    src: (await import(`../assets/audio/tombeau.m4a`)).default,
    filename: "tombeau.m4a",
    name: "Ravel: Le Tombeau de Couperin",
    description: "1st movement solo",
  },
  {
    id: "alwyn",
    src: (await import(`../assets/audio/alwyn.m4a`)).default,
    filename: "alwyn.m4a",
    name: "Alwyn: Oboe Sonata",
    description: "1st movement opening",
  },
  {
    id: "magnificat",
    src: (await import(`../assets/audio/magnificat.m4a`)).default,
    filename: "magnificat.m4a",
    name: "Bach: Magnificat",
    description: "Quia Respexit, oboe d’amore solo",
  },
  {
    id: "stravinsky",
    src: (await import(`../assets/audio/stravinsky.mp3`)).default,
    filename: "stravinsky.mp3",
    name: "Stravinsky: Persephone",
    description: "Oboe solo",
  },
];
---

<Layout pageTitle="Listen to audio excerpts">
  <Section className="wrapper flow prose" as="div">
    <Heading level={1} emphasis>Audio excerpts</Heading>

    <p>
      Below are a selection of audio excerpts featuring my playing in various
      orchestral and chamber music settings. Click on a title to listen.
    </p>

    <Card className="audio-player">
      <ul
        class="playlist"
        aria-label="Playlist of James Button's audio excerpts"
      >
        {
          songs.map((song) => {
            return (
              <li>
                <button
                  data-id={song.id}
                  class="audio-control"
                  aria-label={`Play ${song.name}`}
                  aria-controls={`audio-${song.id}`}
                >
                  <PlayingIcon />
                  <PlayIcon />
                  {song.name}
                </button>
                <audio
                  src={song.src}
                  data-id={song.id}
                  data-name={song.name}
                  data-description={song.description}
                  id={`audio-${song.id}`}
                />
              </li>
            );
          })
        }
      </ul>

      <div class="song-deck standby">
        <div class="placeholder"><MusicIcon /><p>Select a song</p></div>
        <div class="song-info">
          <strong class="now-playing">Now playing</strong>
          <Heading level={3} className="song-title" />
          <p class="song-description"></p>
        </div>

        <aside class="audio-controls" aria-label="Audio controls">
          <button class="audio-control play-button" aria-label="Play">
            <PlayIcon />
          </button>
          <button class="audio-control pause-button" aria-label="Pause">
            <PauseIcon />
          </button>
          <button class="audio-control rewind-button" aria-label="Rewind">
            <RewindIcon />
          </button>
        </aside>
      </div>
    </Card>
  </Section>
</Layout>

<style>
  .audio-player {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    font-size: var(--size-step-0);
  }

  .playlist {
    .icon {
      height: 0.75rem;
      width: 0.75rem;
      margin-inline-end: var(--space-xs);
      margin-inline-start: -1.5rem;
    }

    .audio-control {
      display: block;
      padding-block: var(--space-xs);
      padding-inline-start: 1.5rem;
    }

    .icon--playing {
      display: none;
    }

    [aria-current="true"] {
      .icon--play {
        display: none;
      }

      .icon--playing {
        display: inline-block;
        animation: pulse 2s ease-in-out infinite;
      }
    }
  }

  .song-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-block-end: var(--space-s);

    .standby & {
      display: none;
    }
  }

  .audio-controls {
    display: flex;
    gap: var(--space-m);
    justify-content: center;
    background-color: var(--color-shade-2);
    border-radius: var(--radius-m);
    padding: var(--space-xs);

    .standby & {
      display: none;
    }

    .audio-control {
      display: none;

      &:not([aria-pressed="true"]) {
        display: block;
      }
    }

    .icon {
      display: block;
      height: 2rem;
      width: 2rem;

      &:not(.icon--rewind) {
        fill: var(--color-dark);
      }
    }
  }

  .song-deck {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-shade-3);
    border-radius: var(--radius-m);
    padding: var(--space-m);
    outline: 1px solid var(--color-shade-3);
    outline-offset: 2px;

    &.standby {
      justify-content: center;
    }
  }

  .placeholder {
    text-align: center;
  }

  .song-title {
    font-size: var(--size-step-01);
  }

  .song-description {
    font-size: var(--size-step-00);
  }

  .now-playing {
    text-transform: uppercase;
    font-size: var(--size-step-000);
    font-weight: 400;
  }

  @keyframes pulse {
    0% {
      opacity: 1;
      transform: scale(1.2);
    }
    50% {
      opacity: 0.25;
      transform: scale(1);
    }
    100% {
      opacity: 1;
      transform: scale(1.2);
    }
  }
</style>

<script>
  const SELECTORS = {
    playlist: ".playlist",
    rewindButton: ".rewind-button",
    playButton: ".play-button",
    pauseButton: ".pause-button",
    songDeck: ".song-deck",
    songTitle: ".song-title",
    songDescription: ".song-description",
    placeholder: ".placeholder",
  };

  // Cache DOM elements
  const elements = {
    playlist: document.querySelector(
      SELECTORS.playlist
    ) as HTMLUListElement | null,
    rewindButton: document.querySelector(
      SELECTORS.rewindButton
    ) as HTMLButtonElement | null,
    playButton: document.querySelector(
      SELECTORS.playButton
    ) as HTMLButtonElement | null,
    pauseButton: document.querySelector(
      SELECTORS.pauseButton
    ) as HTMLButtonElement | null,
    songDeck: document.querySelector(
      SELECTORS.songDeck
    ) as HTMLDivElement | null,
    songTitle: document.querySelector(
      SELECTORS.songTitle
    ) as HTMLElement | null,
    songDescription: document.querySelector(
      SELECTORS.songDescription
    ) as HTMLElement | null,
    placeholder: document.querySelector(
      SELECTORS.placeholder
    ) as HTMLElement | null,
  };

  // State management
  let currentAudio: HTMLAudioElement | null = null;
  let isPlaying = false;

  // Helper: Update play/pause button states
  function updatePlayPauseButtons(playing: boolean) {
    isPlaying = playing;
    elements.pauseButton?.setAttribute(
      "aria-pressed",
      playing ? "false" : "true"
    );
    elements.playButton?.setAttribute(
      "aria-pressed",
      playing ? "true" : "false"
    );
  }

  // Helper: Update song info display
  function updateSongInfo(audio: HTMLAudioElement) {
    if (elements.songTitle)
      elements.songTitle.textContent = audio.dataset.name || "";
    if (elements.songDescription)
      elements.songDescription.textContent = audio.dataset.description || "";
    elements.placeholder?.remove();
    elements.songDeck?.classList.remove("standby");
  }

  // Helper: Update playlist active state
  function updatePlaylistActive(button: HTMLButtonElement | null) {
    const active = elements.playlist?.querySelector("[aria-current]");
    if (active) active.removeAttribute("aria-current");
    if (button) button.setAttribute("aria-current", "true");
  }

  // Play or toggle a song
  function playOrToggleSong(id: string) {
    const audio = elements.playlist?.querySelector(
      `audio[data-id="${id}"]`
    ) as HTMLAudioElement | null;
    if (!audio) return;

    if (currentAudio === audio) {
      // Same song: toggle play/pause
      if (isPlaying) {
        pausePlayback();
      } else {
        resumePlayback();
      }
    } else {
      // New song: pause current, switch, and play
      if (currentAudio) currentAudio.pause();
      currentAudio = audio;
      audio.currentTime = 0;
      try {
        audio.play();
        updatePlayPauseButtons(true);
        updateSongInfo(audio);
      } catch (error) {
        console.error("Audio playback failed:", error);
      }
    }
  }

  // Rewind current song
  function rewindPlayback() {
    if (currentAudio) {
      currentAudio.currentTime = 0;
      if (!isPlaying) resumePlayback(); // Auto-resume if paused
    }
  }

  // Pause playback
  function pausePlayback() {
    if (currentAudio) currentAudio.pause();
    updatePlayPauseButtons(false);
  }

  // Resume playback
  function resumePlayback() {
    if (currentAudio) {
      try {
        currentAudio.play();
        updatePlayPauseButtons(true);
      } catch (error) {
        console.error("Audio resume failed:", error);
      }
    }
  }

  // Event listeners
  elements.playlist?.addEventListener("click", (e) => {
    const button = (e.target as HTMLElement).closest(
      ".audio-control"
    ) as HTMLButtonElement | null;
    if (!button) return;

    const songId = button.dataset.id;
    if (songId) {
      updatePlaylistActive(button);
      playOrToggleSong(songId);
    }
  });

  elements.pauseButton?.addEventListener("click", pausePlayback);
  elements.rewindButton?.addEventListener("click", rewindPlayback);
  elements.playButton?.addEventListener("click", resumePlayback);

  // Audio event listeners for automatic UI syncing
  document.addEventListener(
    "play",
    (e) => {
      if (e.target instanceof HTMLAudioElement && e.target === currentAudio) {
        updatePlayPauseButtons(true);
      }
    },
    true
  );

  document.addEventListener(
    "pause",
    (e) => {
      if (e.target instanceof HTMLAudioElement && e.target === currentAudio) {
        updatePlayPauseButtons(false);
      }
    },
    true
  );

  document.addEventListener(
    "ended",
    (e) => {
      if (e.target instanceof HTMLAudioElement && e.target === currentAudio) {
        updatePlayPauseButtons(false);
      }
    },
    true
  );
</script>
