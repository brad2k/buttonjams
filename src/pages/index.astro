---
import { Picture } from "astro:assets";
import heroAvif from "../assets/hero-5568×3712.avif";
import Layout from "../layouts/Layout.astro";
import Heading from "../components/Heading.astro";
---

<Layout wrapperClass="hero-container" pageType="home">
  <Heading level={1} as={4} className="hero-title">
    <span>San Francisco Symphony</span>
    <span class="job-title">Associate Principal Oboe</span>
  </Heading>

  <Picture
    class="hero-image"
    src={heroAvif}
    formats={["avif", "webp"]}
    alt="James Button holding his Marigaux 920A oboe in the lobby of Davies Symphony Hall"
    priority
    width={5568}
    height={3712}
    layout="full-width"
    pictureAttributes={{ class: "hero-picture" }}
  />
</Layout>

<style>
  .hero-container {
    height: 100dvh;
    position: relative;
  }

  .hero-picture {
    height: 100%;
  }

  .hero-title {
    position: absolute;
    bottom: 3rem;
    right: 50%;
    transform: translateX(50%);
    background: oklch(from var(--color-light) l c h / 0.75);
    font-family: var(--font-Playfair);
    border-radius: var(--radius-m);
    padding: 2rem;
    max-width: unset;

    @media (min-width: 55rem) {
      right: 3rem;
      transform: unset;
      background: oklch(from var(--color-light) l c h / 0.5);
    }

    span {
      display: block;
      text-wrap: nowrap;
    }
  }

  .job-title {
    font-size: 75%;
    text-align: right;
    color: oklch(from var(--color-dark) l c h / 0.85);
  }

  .hero-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: 30% 0;
    transition: 0.3s ease-in-out object-position;
    color: transparent;

    @media (min-width: 55rem) {
      object-position: 50% 20%;
    }
  }
</style>
