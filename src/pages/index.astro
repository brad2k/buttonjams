---
import { Picture } from "astro:assets";
import heroAvif from "../assets/hero-4000x2667.avif";
import Layout from "../layouts/Layout.astro";
import Heading from "../components/Heading.astro";
---

<Layout wrapperClass="hero-container" pageType="home">
  <Heading level={1} as={4} className="hero-title">
    <span class="sfs">San Francisco Symphony</span>
    <span class="job-title">Associate Principal Oboe</span>
  </Heading>

  <Picture
    class="hero-image"
    src={heroAvif}
    formats={["avif", "webp"]}
    alt="James Button holding his Marigaux 920A oboe in the lobby of Davies Symphony Hall"
    priority
    width={4000}
    height={2667}
    layout="full-width"
    position="30% 0%"
    pictureAttributes={{ class: "hero-picture" }}
  />
</Layout>

<style>
  .hero-container {
    height: 100dvh;
    position: relative;
  }

  .hero-picture {
    display: block;
    height: 100%;
  }

  .hero-title {
    position: absolute;
    bottom: 3rem;
    right: 50%;
    transform: translateX(50%);
    background: oklch(from var(--color-neutral-100) l c h / 0.75);
    color: var(--color-dark-700);
    font-family: var(--font-Playfair);
    font-weight: 400;
    border-radius: var(--radius-m);
    padding: 2rem;

    @media (min-width: 50rem) {
      right: 3rem;
      transform: unset;
      background: oklch(from var(--color-neutral-100) l c h / 0.5);
    }

    span {
      display: block;
      text-wrap: nowrap;
    }
  }

  .job-title {
    font-size: 75%;
    text-align: right;
    color: var(--color-dark-600);
  }

  .hero-image {
    height: 100%;
    transition: object-position var(--transition-base);
    object-fit: cover;
    color: transparent;

    @media (min-width: 50rem) {
      object-position: 50% 20%;
    }
  }
</style>
