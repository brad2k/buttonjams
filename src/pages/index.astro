---
import Layout from "../layouts/Layout.astro";

import { Image, Picture } from "astro:assets";
import heroAvif5568 from "../assets/hero-5568×3712.avif";
import heroWebp5568 from "../assets/hero-5568×3712.webp";
import heroJpg5568 from "../assets/hero-5568×3712.jpg";
---

<Layout>
  <div class="hero-container">
    <!-- <Picture
          class="hero-image"
          src={heroAvif}
          formats={["avif"]}
          fallbackFormat="jpg"
          alt="James Button"
          fetchpriority="high"
          loading="eager"
          layout="full-width"
          position="50% 20%"
          fit="cover"
          width={5568}
          height={3712}
          pictureAttributes={{ class: "hero-picture" }}
        /> -->
    <picture class="hero-picture">
      <source srcset={heroAvif5568.src} type="image/avif" />
      <source srcset={heroWebp5568.src} type="image/webp" />

      <img
        class="hero-image"
        src={heroJpg5568.src}
        alt="James Button"
        fetchpriority="high"
        loading="eager"
        width={5568}
        height={3712}
      />
    </picture>
  </div>
</Layout>

<style>
  .hero-container {
    height: 100dvh;
  }

  .hero-picture {
    height: 100%;
  }

  .hero-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: 30% 0;
    transition: 0.3s ease-in-out object-position;
    color: transparent;

    @media (min-width: 55rem) {
      object-position: 50% 20%;
    }
  }
</style>
