  .watch-listen-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-auto-columns: 100%;
    grid-auto-rows: max-content;
    gap: var(--space-m);
  }

  .music-row {
    grid-column: 1 / 4;
  }

  #watch-and-listen,
  #events,
  #contact,
  #music {
    --flow-space: var(--space-l);
  }

  #contact {
    background-color: oklch(0.462 0.004 106.5);
    color: var(--color-light);
  }
</style>
