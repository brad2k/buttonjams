<style>
  .hero-container {
    height: 100dvh;
  }

  .hero-picture {
    height: 100%;
  }

  .hero-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: 30% 0;
    transition: 0.3s ease-in-out object-position;
    color: transparent;

    @media (min-width: 55rem) {
      object-position: 50% 20%;
    }
  }

