---
import { Picture } from "astro:assets";
import heroAvif from "../assets/hero-5568×3712.avif";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="hero-container">
    <Picture
      class="hero-image"
      src={heroAvif}
      formats={["avif", "webp"]}
      alt="James Button holding his Marigaux 920A oboe in the lobby of Davies Symphony Hall"
      priority
      width={5568}
      height={3712}
      layout="full-width"
      pictureAttributes={{ class: "hero-picture" }}
    />
  </div>
</Layout>

<style>
  .hero-container {
    height: 100dvh;
  }

  .hero-picture {
    height: 100%;
  }

  .hero-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: 30% 0;
    transition: 0.3s ease-in-out object-position;
    color: transparent;

    @media (min-width: 55rem) {
      object-position: 50% 20%;
    }
  }
</style>
