---
import Event from "../components/Event.astro";
import Heading from "../components/Heading.astro";
import Section from "../components/Section.astro";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import { loadQuery } from "../sanity/lib/load-query";

interface SanityEvent {
  _id: string;
  title: string;
  category: string;
  dateTime: string;
  timezone: string;
  location: string;
  link: string;
  description?: string;
}

const { data: events } = await loadQuery<SanityEvent[]>({
  query: `*[_type == "event" && dateTime > now()] | order(dateTime asc) {
    _id, title, category, dateTime, timezone, location, link, description
  }`,
});

function formatEventDate(dateTime: string, timezone: string) {
  return new Intl.DateTimeFormat("en-US", {
    weekday: "short",
    month: "long",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZoneName: "short",
    timeZone: timezone,
  }).format(new Date(dateTime));
}
---

<Layout pageTitle="Upcoming events">
  <Section className="wrapper flow event-grid" as="div">
    <header class="prose flow">
      <Heading level={1} emphasis>Special events</Heading>

      <p>
        I perform regularly with the San Francisco Symphony in my role as
        Associate Principal Oboe, but I occasionally give masterclasses, join in
        recitals, and play with other orchestras.
      </p>
    </header>

    <ul class="event-list grid">
      {
        events.map((event) => (
          <Event
            category={event.category}
            title={event.title}
            dateTime={formatEventDate(event.dateTime, event.timezone)}
            link={event.link}
            location={event.location}
          >
            {event.description}
          </Event>
        ))
      }
      {
        events.length === 0 && (
          <Card>
            There are no upcoming special events, but you can still find me
            playing regularly at the SF Symphony.
          </Card>
        )
      }
    </ul>
  </Section>
</Layout>

<style>
  .event-grid {
    --flow-space: var(--space-l);
  }

  .event-list {
    --grid-placement: auto-fit;

    font-size: var(--size-step-00);
    text-align: center;
  }
</style>
