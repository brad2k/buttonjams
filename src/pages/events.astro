---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import Event from "../components/Event.astro";
---

<Layout>
  <main>
    <Section className="wrapper prose event-grid">
      <Heading level={2} emphasis>Special events</Heading>

      <p>
        I perform regularly with the San Francisco Symphony in my role as
        Associate Principal Oboe, but I occasionally give masterclasses, join in
        recitals, and play with other orchestras.
      </p>

      <ul class="event-list grid">
        <Event
          category="Masterclass"
          title="Oboe Masterclass and guest recital"
          dateTime="Sun, Feb 1, 2026 at 09:30am CST"
          link="https://music.wisc.edu/double-reed-day-2026/"
          location="University of Madison, Madison, WI"
        >
          Performance and masterclass as part of the University of Wisconsin’s
          Double Reed Day.
        </Event>

        <Event
          category="Performance"
          title="Chamber Music at Davies Symphony Hall"
          dateTime="Sun, May 3, 2026 at 2:00pm PST"
          link="https://www.sfsymphony.org/Buy-Tickets/2025-26/CHAMBER-DSH-MAY"
          location="Mondavi Center, UC Davis, Davis, CA"
        >
          Performing Prokofiev’s Quintet with San Francisco Symphony colleagues.
        </Event>

        <Event
          category="Performance"
          title="Santa Rosa Symphony Youth Orchestra"
          dateTime="Sat, May 9, 2026 at 2:00pm PST"
          link="https://www.srsymphony.org/event/srsyomay2026/"
          location="Green Music Center, Rohnert Park, CA"
        >
          Performing Johann Nepomuk Hummel’s Introduction, Theme and Variations
          for Oboe and Orchestra with the Santa Rosa Symphony Youth Orchestra.
        </Event>
      </ul>
    </Section>
  </main>
</Layout>

<style>
  .event-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .event-list {
    --grid-placement: auto-fit;

    font-size: var(--size-step-00);
    text-align: center;
  }
</style>
