---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import Prose from "../components/Prose.astro";
import Card from "../components/Card.astro";

import denimPhoto from "../assets/james-button-denim.avif";
---

<Layout>
  <Section className="wrapper flow prose" as="div">
    <Heading level={1} emphasis>Get in touch</Heading>

    <p>
      I’m always happy to hear from fellow musicians, students, and enthusiasts.
      Whether you have questions about my performances, want to discuss
      potential collaborations, or are interested in lessons or coaching, please
      don’t hesitate to reach out.
    </p>

    <Prose>
      <figure slot="figure">
        <Image
          src={denimPhoto}
          width={denimPhoto.width / 2}
          alt="James Button holding his Marigaux 920A oboe"
          class="prose--image"
          format="avif"
          densities={[1, 1.5, 2]}
        />
      </figure>

      <aside>
        <h3 class="visually-hidden">Send me a message</h3>

        <Card id="success-message" hidden>
          <Heading level={2} as={5}>Thanks for your message!</Heading>
          <p>I’ll get back to you as soon as I can.</p>
        </Card>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          data-netlify-recaptcha="true"
        >
          <div class="contact-form">
            <input
              type="hidden"
              name="subject"
              data-remove-prefix
              value="Inquiry from jamesbuttonoboe.com"
            />

            <div>
              <label>
                <span class="form-label-text">Your name:</span>
                <input type="text" name="name" required class="contact-field" />
              </label>
            </div>
            <div>
              <label>
                <span class="form-label-text">Your email:</span>
                <input
                  type="email"
                  name="email"
                  required
                  class="contact-field"
                />
              </label>
            </div>
            <div>
              <label>
                <span class="form-label-text">Message:</span>
                <textarea name="message" class="contact-field" required
                ></textarea>
              </label>
            </div>
            <div data-netlify-recaptcha="true"></div>
            <div>
              <button type="submit" class="button">Send</button>
            </div>
          </div>
        </form>
      </aside>
    </Prose>
  </Section>
</Layout>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-s);
    font-size: var(--size-step-0);

    button {
      width: 100%;
    }
  }

  .contact-field {
    padding: 0.75rem;
    width: 100%;

    &:user-invalid {
      border: 2px dashed red;
    }
  }

  .form-label-text {
    margin-block-end: 0.5rem;
    display: block;
  }

  #success-message {
    &[hidden] {
      display: none;
    }
  }
</style>

<script>
  const handleSubmit = (event: Event) => {
    event.preventDefault();

    const myForm = event.target as HTMLFormElement;
    const submitButton = myForm.querySelector(
      'button[type="submit"]'
    ) as HTMLButtonElement;

    submitButton.setAttribute("disabled", "disabled");
    myForm.setAttribute("aria-busy", "true");

    const formData = new FormData(myForm);

    fetch("/", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams(formData as any).toString(),
    })
      .then(() => {
        myForm.setAttribute("aria-busy", "false");
        myForm.setAttribute("hidden", "hidden");
        myForm.reset();
        submitButton.setAttribute("disabled", "false");
        document.getElementById("success-message")?.removeAttribute("hidden");
      })
      .catch((error) => console.log(error));
  };

  document.querySelector("form")?.addEventListener("submit", handleSubmit);
</script>
