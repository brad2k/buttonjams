---
interface Props {
  className?: string;
}

const { className, ...rest } = Astro.props;
---

<section class:list={["prose", "prose-grid", className]} {...rest}>
  <slot name="figure" />
  <div class="flow"><slot /></div>
</section>

<style>
  .prose {
    --flow-space: var(--space-l);
  }

  .prose-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);

    @media (min-width: 50rem) {
      grid-template-columns: 2fr 3fr;
    }

    img {
      border: 1px solid var(--border-color);
      border-radius: var(--radius-m);
      width: 100%;
    }

    figcaption {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      font-size: var(--size-step-00);
      margin-block-start: 0.5em;
    }

    .lucide {
      height: 1.2em;
      width: 1.2em;
    }
  }
</style>
