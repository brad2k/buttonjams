---
import "../styles/imports.css";

import Head from "../components/Head.astro";
import Navigation from "../components/Navigation.astro";

interface Props {
  heroImage?: string;
  heroImageSrcSet?: string;
  heroImageSizes?: string;
  pageTitle?: string;
  pageType?: string;
  wrapperClass?: string;
}

const { heroImage, heroImageSrcSet, heroImageSizes, pageTitle, pageType, wrapperClass, ...rest } = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <Head pageTitle={pageTitle} heroImage={heroImage} heroImageSrcSet={heroImageSrcSet} heroImageSizes={heroImageSizes} />
  <body>
    <Navigation />
    <main class:list={[wrapperClass]} {...rest}><slot /></main>
    <footer class="footer">
      <div class="wrapper footer-wrapper">
        <span>James Button © {year}</span><span
          >Website by Brad Azevedo{
            pageType === "home" ? " | Photo by Anne Richardson" : null
          }</span
        >
      </div>
    </footer>
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
  }

  .footer {
    padding-block: var(--space-xs);
    font-size: var(--size-step-000);
    background-color: var(--footer-bg);
    color: var(--footer-text);
  }

  .footer-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
</style>
