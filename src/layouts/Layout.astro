---
import "../styles/reset.css";
import "../styles/base.css";

import Head from "../components/Head.astro";
import Navigation from "../components/Navigation.astro";

interface Props {
  pageTitle?: string;
  pageType?: string;
  wrapperClass?: string;
}

const { pageTitle, pageType, wrapperClass, ...rest } = Astro.props;
---

<!doctype html>
<html lang="en">
  <Head pageTitle={pageTitle} />
  <body>
    <Navigation />
    <main class:list={[wrapperClass]} {...rest}><slot /></main>
  </body><footer class="footer">
    <div class="wrapper footer-wrapper">
      <span>James Button © 2026</span><span
        >Website by Brad Azevedo{
          pageType === "home" ? " | Photo by Anne Richardson" : null
        }</span
      >
    </div>
  </footer>
</html>

<style>
  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
  }

  .footer {
    padding-block: var(--space-xs);
    font-size: var(--size-step-00);
    background-color: var(--color-shade-4);
    color: var(--color-light);
  }

  .footer-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
</style>
